{
  "compilerOptions": {
    "baseUrl": "./app",
    "paths": {
      "@screens/*": ["./screens/*"]
    },
    "jsx": "react-native",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "target": "esnext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["app/**/*", "index.ts", "index.js", "metro.config.js"],
  "exclude": ["node_modules", "babel.config.js"]
}